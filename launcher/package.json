{
  "name": "hardwood-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "A small desktop launcher for Hardwood Autochess: install, patch, launch, and a native C++ sim.",
  "author": "Brooks Roley",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron . --smoke",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "electron": "33.2.0",
    "electron-vite": "2.3.0",
    "eslint": "9.13.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.12.2",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
